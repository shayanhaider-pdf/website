{
  "id": "./index.html",
  "name": "Starstrike Frontier",
  "short_name": "Starstrike",
  "description": "A neon space survival arcade for iPhone and browsers.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#050a19",
  "theme_color": "#071023",
  "icons": [
    {
      "src": "./icons/icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}